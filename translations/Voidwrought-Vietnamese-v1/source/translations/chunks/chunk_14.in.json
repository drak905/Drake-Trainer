[
 {
  "id": 1474,
  "ctx": "term Dialogue/lore_stone_sacral_tower_01",
  "en": "They lifted their gaze towards the umbral sky and could not look away. Spellbound by the endless, dark expanse, they struggled to understand."
 },
 {
  "id": 1475,
  "ctx": "term Dialogue/lore_stone_sacral_tower_02",
  "en": "The further they looked, the more stars they found, and the deeper the darkness grew. Within, they found the means of creation."
 },
 {
  "id": 1476,
  "ctx": "term Dialogue/lore_stone_sacral_tower_03",
  "en": "They drew constellations, mapped the heavens, and created splendors without equal. But as they stared into the dark, something beheld them in turn."
 },
 {
  "id": 1477,
  "ctx": "term Dialogue/lore_stone_sacral_tower_04",
  "en": "Through the cracks of the Void, new Light emerged. A Light unlike any other, as crimson as blood."
 },
 {
  "id": 1478,
  "ctx": "term Dialogue/lore_stone_the_shrine",
  "en": "The Whole"
 },
 {
  "id": 1479,
  "ctx": "term Dialogue/lore_stone_the_shrine_01",
  "en": "Unmade."
 },
 {
  "id": 1480,
  "ctx": "term Dialogue/lore_stone_the_shrine_02",
  "en": "Parts of the whole, scattered."
 },
 {
  "id": 1481,
  "ctx": "term Dialogue/lore_stone_the_shrine_03",
  "en": "A mind caged."
 },
 {
  "id": 1482,
  "ctx": "term Dialogue/lore_stone_the_shrine_04",
  "en": "What was shattered shall be remade."
 },
 {
  "id": 1483,
  "ctx": "term Dialogue/lore_stone_the_shrine_05",
  "en": "Reborn."
 },
 {
  "id": 1484,
  "ctx": "term Dialogue/lore_stone_god_cradle_01",
  "en": "Wayward spawn."
 },
 {
  "id": 1485,
  "ctx": "term Dialogue/lore_stone_god_cradle_02",
  "en": "From whence they crawled, they shall be made to return."
 },
 {
  "id": 1486,
  "ctx": "term Dialogue/lore_stone_god_cradle_03",
  "en": "Each part of the whole."
 },
 {
  "id": 1487,
  "ctx": "term Dialogue/lore_stone_god_cradle_04",
  "en": "It nears."
 },
 {
  "id": 1488,
  "ctx": "term Tutorial/",
  "en": "Press _"
 },
 {
  "id": 1489,
  "ctx": "term Tutorial/tut_artifacts_title",
  "en": "Artifacts"
 },
 {
  "id": 1490,
  "ctx": "term Tutorial/tut_artifacts_01",
  "en": "You have acquired an <b>Artifact</b>."
 },
 {
  "id": 1491,
  "ctx": "term Tutorial/tut_artifacts_02 (+1 more)",
  "en": "Relics house powerful activated effects, triggered by spending Void Charges.\nVoid Charges are replenished by visiting Chambers of Reflection or by hitting enemies."
 },
 {
  "id": 1492,
  "ctx": "term Tutorial/tut_artifacts_03",
  "en": "Void Charges are replenished by visiting Chambers of Reflection or by hitting enemies."
 },
 {
  "id": 1493,
  "ctx": "term Tutorial/tut_artifacts_04",
  "en": "Crests offer passive boons that remain active at all times after the Crest has been equipped."
 },
 {
  "id": 1494,
  "ctx": "term Tutorial/tut_artifacts_06",
  "en": "Navigate to the Artifact menu"
 },
 {
  "id": 1495,
  "ctx": "term Tutorial/tut_artifacts_07",
  "en": "to equip discovered Artifacts."
 },
 {
  "id": 1496,
  "ctx": "term Tutorial/tut_relics_title",
  "en": "You have acquired a <b>Relic</b>."
 },
 {
  "id": 1497,
  "ctx": "term Tutorial/tut_relics_02",
  "en": "to view and Equip discovered Relics."
 },
 {
  "id": 1498,
  "ctx": "term Tutorial/tut_souls_title",
  "en": "You have acquired a <b>Soul</b>."
 },
 {
  "id": 1499,
  "ctx": "term Tutorial/tut_souls_01",
  "en": "The countless Souls lingering throughout the Gray City may still be called upon, providing passive boons that remain active after the Soul has been Summoned."
 },
 {
  "id": 1500,
  "ctx": "term Tutorial/tut_souls_02",
  "en": "to view and Summon acquired Souls."
 },
 {
  "id": 1501,
  "ctx": "term Tutorial/tut_simulacrum_01",
  "en": "You have acquired a new <b>Simulacrum</b>."
 },
 {
  "id": 1502,
  "ctx": "term Tutorial/tut_simulacrum_02",
  "en": "You may view all acquired Simulacra in the Compendium."
 },
 {
  "id": 1503,
  "ctx": "term Tutorial/tut_healing_salt_01",
  "en": "to restore Health by absorbing refined, crystallized vitae."
 },
 {
  "id": 1504,
  "ctx": "term Tutorial/tut_healing_salt_02",
  "en": "Empty Salt Receptacles are replenished in Chambers of Reflection."
 },
 {
  "id": 1505,
  "ctx": "term Tutorial/tut_slide_01",
  "en": "to Slide through small openings and reach otherwise inaccessible areas."
 },
 {
  "id": 1506,
  "ctx": "term Tutorial/tut_possession_01",
  "en": "while near ancient technology to Possess and manipulate it."
 },
 {
  "id": 1507,
  "ctx": "term Tutorial/tut_dash_01",
  "en": "to quickly Dash forward, traversing gaps and evading danger."
 },
 {
  "id": 1508,
  "ctx": "term Tutorial/tut_double_jump_01",
  "en": "again while airborne to perform a second Jump, reaching higher locations."
 },
 {
  "id": 1509,
  "ctx": "term Tutorial/tut_tendril_01",
  "en": "while airborne to latch on to nearby Hooks, breaching chasms and avoiding obstacles."
 },
 {
  "id": 1510,
  "ctx": "term Tutorial/tut_charge_attack_01",
  "en": "until fully Charged, then release to perform a devastating Charged Attack."
 },
 {
  "id": 1511,
  "ctx": "term Tutorial/tut_charge_attack_02",
  "en": "Charged Attacks will destroy or manipulate objects infused with Voidal energy."
 },
 {
  "id": 1512,
  "ctx": "term Tutorial/tut_void_step_01",
  "en": "to manifest a Void Sphere."
 },
 {
  "id": 1513,
  "ctx": "term Tutorial/tut_void_step_02",
  "en": "Release near a Void Breach to travel towards it, phasing through solid matter."
 },
 {
  "id": 1514,
  "ctx": "term Tutorial/tut_slither_01",
  "en": "to become amorphous, capable of clinging to surfaces and slithering through narrow tunnels."
 },
 {
  "id": 1515,
  "ctx": "term Tutorial/tut_slither_02",
  "en": "to perform a special Attack while in this form."
 },
 {
  "id": 1516,
  "ctx": "term Tutorial/tutorial_heal2",
  "en": "to Heal"
 },
 {
  "id": 1517,
  "ctx": "term Tutorial/tutorial_doublejump_title (+1 more)",
  "en": "Double Jump"
 },
 {
  "id": 1518,
